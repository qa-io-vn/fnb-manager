{
	"name": "@fnb/zalo-customer",
	"private": true,
	"version": "0.1.0",
	"description": "The customer Zalo Mini App: one build per brand from configuration, run in a browser with the mocked Zalo SDK",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && node ../../packages/zalo-mini/scripts/check-budget.mjs --app . --dist dist",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:local": "playwright test -c playwright.local.config.ts --project local",
		"standees": "tsx scripts/standees.ts",
		"e2e:install": "playwright install chromium"
	},
	"dependencies": {
		"@fnb/design-tokens": "workspace:^",
		"@fnb/zalo-mini": "workspace:^",
		"@tailwindcss/vite": "^4.3.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.5",
		"tailwindcss": "^4.3.5",
		"uqr": "0.1.3",
		"zmp-sdk": "2.53.3",
		"zmp-ui": "1.11.15-2"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^25.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"jsdom": "^31.0.0",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
