{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"noEmit": true,
		"declaration": false,
		"sourceMap": false,
		"types": ["vite/client"],
		"useDefineForClassFields": true
	},
	"include": ["src"]
}
