{
	"name": "@fnb/web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && node scripts/check-bundle.mjs && node scripts/check-size.mjs",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"check:bundle": "node scripts/check-bundle.mjs",
		"check:size": "node scripts/check-size.mjs",
		"e2e:install": "playwright install chromium",
		"icons:render": "node scripts/render-icons.mjs",
		"docs:screenshots": "playwright test -c playwright.user-guide.config.ts"
	},
	"dependencies": {
		"@fnb/connector-core": "workspace:^",
		"@fnb/connector-mock": "workspace:^",
		"@fnb/core": "workspace:^",
		"@fnb/demo-analytics": "workspace:^",
		"@fnb/metrics": "workspace:^",
		"@fnb/reports": "workspace:^",
		"@supabase/supabase-js": "^2.119.0",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-query": "^5.107.1",
		"echarts": "^6.1.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.5",
		"tailwindcss": "^4.3.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^25.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"jsdom": "^31.0.0",
		"vite": "^8.3.6"
	}
}
