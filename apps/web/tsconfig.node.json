{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"declaration": false,
		"sourceMap": false,
		"types": ["node"]
	},
	"include": [
		"vite.config.ts",
		"vitest.config.ts",
		"playwright.config.ts",
		"playwright.user-guide.config.ts",
		"e2e",
		"user-guide"
	]
}
