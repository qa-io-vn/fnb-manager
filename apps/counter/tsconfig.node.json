{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"declaration": false,
		"sourceMap": false,
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"types": ["node"]
	},
	"include": [
		"vite.config.ts",
		"vitest.config.ts",
		"vitest.integration.config.ts",
		"playwright.config.ts",
		"vite",
		"e2e",
		"test"
	]
}
