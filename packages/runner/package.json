{
	"name": "@fnb/runner",
	"version": "0.1.0",
	"description": "Runner wiring shared by the fnb CLI and the sync-incremental Edge Function: POS account entries, connector sessions, the incremental store run, the Notifier and the dead-man's switch",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./postgres": {
			"types": "./src/postgres/index.ts",
			"import": "./src/postgres/index.ts"
		}
	},
	"files": [
		"src"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@fnb/connector-core": "workspace:^",
		"@fnb/connector-ipos": "workspace:^",
		"@fnb/connector-mock": "workspace:^",
		"@fnb/core": "workspace:^",
		"@fnb/sync": "workspace:^",
		"postgres": "^4.1.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^25.0.0",
		"vitest": "^5.1.0"
	}
}
