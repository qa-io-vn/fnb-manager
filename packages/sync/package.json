{
	"name": "@fnb/sync",
	"version": "0.1.0",
	"description": "POS-agnostic sync engine: canonical sales into the tenant database with void and edit detection, adjustments and reconciliation checks",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./postgres": {
			"types": "./src/postgres/index.ts",
			"import": "./src/postgres/index.ts"
		}
	},
	"files": [
		"src"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@fnb/connector-core": "workspace:^",
		"@fnb/core": "workspace:^",
		"postgres": "^4.1.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@fnb/connector-mock": "workspace:^",
		"@types/node": "^25.0.0",
		"vitest": "^5.1.0"
	}
}
