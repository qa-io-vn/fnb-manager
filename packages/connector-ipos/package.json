{
	"name": "@fnb/connector-ipos",
	"version": "0.1.0",
	"description": "Typed client and PosConnector adapter for the iPOS Fabi CMS REST API (login, master data, sales reports, invoices, shifts)",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"test:live": "LIVE=1 vitest run test/live"
	},
	"dependencies": {
		"@fnb/connector-core": "workspace:*",
		"@fnb/core": "workspace:*",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@fnb/connector-mock": "workspace:*",
		"@types/node": "^25.0.0",
		"vitest": "^5.1.0"
	}
}
