{
	"name": "@fnb/zalo",
	"version": "0.1.0",
	"description": "The Zalo platform side of FNB Manager: the app-secret proof, a timed HTTP client, the graph me and me/info calls, the Supabase calls of the sign-in functions, the ZALO_INTEGRATION gate and a local mock of Zalo",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./testing": {
			"types": "./src/testing/index.ts",
			"import": "./src/testing/index.ts"
		}
	},
	"files": [
		"src"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run --passWithNoTests",
		"test:integration": "vitest run test/integration"
	},
	"devDependencies": {
		"@types/node": "^25.0.0",
		"postgres": "^4.1.0",
		"vitest": "^5.1.0"
	}
}
