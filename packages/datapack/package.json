{
	"name": "@fnb/datapack",
	"version": "0.1.0",
	"description": "The AI data pack: one aggregate-only, versioned, POS-agnostic document built from the report functions, its canonical text and hash, the strategy prompt, and the plan format with its lint",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./testing": {
			"types": "./src/testing/index.ts",
			"import": "./src/testing/index.ts"
		}
	},
	"files": [
		"src",
		"schema"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"schemas": "node --import tsx scripts/emit-schemas.mjs",
		"golden": "node --import tsx scripts/emit-demo-pack.ts"
	},
	"dependencies": {
		"@fnb/core": "workspace:^",
		"@fnb/metrics": "workspace:^",
		"@fnb/reports": "workspace:^",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@fnb/demo-analytics": "workspace:^",
		"@types/node": "^25.0.0",
		"ajv": "8.20.0",
		"jsdom": "^31.0.0",
		"vitest": "^5.1.0"
	}
}
