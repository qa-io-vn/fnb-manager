{
	"name": "@fnb/design-tokens",
	"version": "0.1.0",
	"description": "Design tokens in the DTCG 2025.10 format, the single source of every colour and font stack, built by Style Dictionary into CSS variables with the Tailwind 4 theme mapping and a typed palette",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./tokens.css": "./src/generated/tokens.css"
	},
	"files": [
		"src",
		"tokens"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "node scripts/build-tokens.mjs",
		"check": "node scripts/build-tokens.mjs --check",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^25.0.0",
		"style-dictionary": "^5.8.0",
		"vitest": "^5.1.0"
	}
}
