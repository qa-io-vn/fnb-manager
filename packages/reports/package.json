{
	"name": "@fnb/reports",
	"version": "0.1.0",
	"description": "Periodic report models shared by the web app, data packs and digests: the analytics contract, periods, coverage, comparisons, decomposition, narrative and the Ngày, Tuần, Tháng and Năm definitions",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"files": [
		"src"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"test:live": "LIVE=1 vitest run test/live"
	},
	"dependencies": {
		"@fnb/core": "workspace:^",
		"@fnb/metrics": "workspace:^",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^25.0.0",
		"postgres": "^4.1.0",
		"vitest": "^5.1.0"
	}
}
